# Discord Bot Credentials
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Comma-separated Discord User IDs allowed to control Antigravity (REQUIRED for security)
DISCORD_ALLOWED_USER_IDS=123456789012345678

# Optional: Comma-separated Channel IDs. Leave empty to allow ALL channels in your server!
DISCORD_CHANNEL_IDS=

# Allow Direct Messages (DMs) from allowed users (true/false)
DISCORD_ALLOW_DM=true

# Optional: Guild (Server) ID for instant slash-command sync (leave empty for multi-server global sync)
DISCORD_GUILD_ID=

# Multi-bot / Multi-server Mention Policy
# When true, the bot only responds to @mentions in servers/channels not listed below
DISCORD_REQUIRE_MENTION=true
DISCORD_FREE_RESPONSE_GUILD_IDS=
DISCORD_FREE_RESPONSE_CHANNEL_IDS=
# Stay silent in free-response channels when user explicitly mentions another bot (e.g. @Hermes)
DISCORD_IGNORE_OTHER_BOT_MENTIONS=true
# Pull up to N missed channel messages since Antigravity's last reply (0 = disable)
DISCORD_MENTION_BACKFILL_LIMIT=15

# Antigravity CLI (agy) Configuration
AGY_BIN=agy
AGY_WORKDIR=.
AGY_MODE=auto
AGY_MODEL=
AGY_AUX_MODEL=
AGY_SANDBOX=false
AGY_SKIP_PERMISSIONS=false
AGY_TIMEOUT_SECONDS=0

# Gateway State & Behavior
GATEWAY_STATE_FILE=state.json
STREAM_EDIT_INTERVAL_SECONDS=1.2

# Optional: Share Hermes SOUL.md, MEMORY.md, and USER.md (off | readonly | readwrite)
HERMES_MEMORY_MODE=off
HERMES_SOUL_FILE=~/.hermes/SOUL.md
HERMES_MEMORY_FILE=~/.hermes/memories/MEMORY.md
HERMES_USER_FILE=~/.hermes/memories/USER.md

# Optional: Session search & cross-channel mention settings
CROSS_CHANNEL_HISTORY_LIMIT=15
CONTEXT_WARN_THRESHOLD=150000
AGY_CONVERSATIONS_DB=~/.gemini/antigravity-cli/conversation_summaries.db
HERMES_STATE_DB=~/.hermes/state.db
